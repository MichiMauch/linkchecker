# LOCAL: nothing needs to be set. The DB is a SQLite file at the repo root
# (linkchecker.db), created automatically on first run.

# PRODUCTION (Turso): point at your hosted libSQL database.
# DATABASE_URL=libsql://your-db-name.turso.io
# DATABASE_AUTH_TOKEN=your-turso-token

# OPENAI — only for the soft-404 LLM fallback (ambiguous pages). Without it, the
# soft-404 detector still runs (probe + heuristics), just no LLM band.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5-mini

# DASHBOARD AUTH — set DASHBOARD_PASSWORD to require a password (shared, single
# password). When unset, the dashboard is open (fine for local dev). AUTH_SECRET
# signs the session cookie; if unset it derives from the password.
# DASHBOARD_PASSWORD=change-me
# AUTH_SECRET=long-random-string

# OPTIONAL — distributed worker mode (large sites, restart-safe, scalable).
# Requires Redis AND a running worker process (npm run worker).
# When unset/false, the dashboard crawls in-process (no Redis needed).
# USE_WORKER=true
# REDIS_URL=redis://localhost:6379
# WORKER_CONCURRENCY=10
